Name: libdcerpc
Summary: DCE/RPC client library using libsmb2 as transport
Vendor: Ronnie Sahlberg
Packager: ronniesahlberg@gmail.com
Version: @VERSION@
Release: 1
Epoch: 0
License: BSD-2-Clause
Group: System Environment/Libraries
URL: http://www.github.com/sahlberg/libsmb2

Source: libdcerpc-%{version}.tar.gz

BuildRequires: gcc, make, autoconf, automake, libtool
BuildRequires: pkgconfig(libsmb2) >= 7.0.0
BuildRequires: ncurses-devel

%description
Libdcerpc is a DCE/RPC client library implementing SRVSVC, LSA, WKSSVC,
WINREG and EPM, using libsmb2 named pipes as transport.

This package also contains the dcerpc, epm-enum and winreg-tui utilities.

#######################################################################

%prep
%setup -q

%build
autoreconf -fi
CFLAGS="$RPM_OPT_FLAGS -O2" %configure
make %{?_smp_mflags}

%install
rm -rf $RPM_BUILD_ROOT
make DESTDIR=$RPM_BUILD_ROOT install

# Do not ship libtool archives
find $RPM_BUILD_ROOT -name "*.la" -exec rm -f {} \;

#######################################################################
## Files section                                                     ##
#######################################################################

%files
%defattr(-,root,root)
%{_libdir}/libdcerpc.so.*
%{_bindir}/dcerpc
%{_bindir}/epm-enum
%{_bindir}/winreg-tui

%package devel
Summary: Development libraries for libdcerpc
Group: Development
Requires: %{name} = %{epoch}:%{version}-%{release}

%description devel
development libraries for libdcerpc

%files devel
%defattr(-,root,root)
%{_includedir}/dcerpc/dcerpc.h
%{_includedir}/dcerpc/dcerpc-dtyp.h
%{_includedir}/dcerpc/dcerpc-epm.h
%{_includedir}/dcerpc/dcerpc-lsa.h
%{_includedir}/dcerpc/dcerpc-srvsvc.h
%{_includedir}/dcerpc/dcerpc-wkssvc.h
%{_includedir}/dcerpc/dcerpc-winreg.h
%{_libdir}/libdcerpc.so
%{_libdir}/libdcerpc.a
%{_libdir}/pkgconfig/libdcerpc.pc

%changelog
* Sat Oct 03 2026 : Version 1.0.0
 - Initial release as a separate library from libsmb2
