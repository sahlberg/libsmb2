axpy — trivial DCE/RPC service with a YAML config
=================================================

axpy: (*A × X plus Y*) is a small external service for
[dcerpcd](../). It shows the full path of:

1. a **data-only IDL** for a human-editable YAML config  
2. an **interface IDL** with one RPC (`compute`)  
3. **hand-written stubs** that use the config  
4. a generic **serviced** worker that registers with dcerpcd  
5. a **sync client** using `dcerpc_call()`

The service implements the classic BLAS level-1 AXPY operation:

---
   y := a * x + y
---

where the scalar 'a' and formatting ('base', 'prefix') come from a YAML
config file. The client supplies 'x' and 'y'; as in BLAS, 'y' is both an
input and an output ([in,out]) and is returned updated. The reply also
carries a string ('prefix' + the new 'y' printed in the chosen base) plus
a WERROR status.

Prerequisites
=============
Libsmb2 and libdcerpc built and installed.

Dcerpcd to be up and running.


Building the server
===================

config.idl
----------
This is the description of the configuration file for the server.
We want to be able to configure the scalar a, the base and the prefix for the
output string.

---
typedef enum {
    BASE_HEX = 1,
    BASE_DEC = 2,
    BASE_OCT = 3
} int_bases;

typedef struct {
	uint32_t a;
	enum int_bases base;
	[string] uint16_t *prefix;
} CONFIG;
---

Then compile this with

$ idlcomp.py config.idl -o config_coder.c

This will generate the two files config_coder.c and config_coder.h
that provides the coders to encode/decode the structures in the idl.

This is convenient because now we don't have to write our own
config file parser. We can just use libdcerpc adn tell it to use YAML
and the encoding as that it human redable and easy to edit.

Lets also create the actual config file as 'config'
---
CONFIG:
  a: 2
  base: 2
  prefix: The result is: 
---

axpy.idl
--------
We need an IDL file for the protocol itself. Here we create a simple protocol
definition with just a single operation : compute

---
[
  uuid(d5d385d6-90b4-421b-89fb-5a08ca755dee),
  version(1.0),
  helpstring("A * X plus Y"),
  endpoint("ncacn_np:[\\pipe\\axpy]"),
  pointer_default(unique)
]
interface axpy
{
	[opnum(0x00)]
	WERROR compute(
		[in] uint32_t x,
		[in,out,ref] uint32_t *y,
		[out,unique,string,charset(UTF16)] uint16_t *result
	);
}
---

And we compile this both into the coders which both the client and server
will use but also into stub routines and a dispatch table that the server will
use.

idlcomp.py axpy.idl -o axpy_coder.c --stubs

This generates the three files axpy_coder.c, axpy_coder.h, axpy_stubs.c
Like in the config example we have two files for the coders that will be used by
both client and server but now we also have an additional file that contains the
bare-bones stubs file that the server will use.

Since all the business logic will be implemented in this stubs file we start by adding
constructors and destructors that will read the config on startup.

To do this we add the following to the file :

--- at the top of the file, before the stubs :
    /* Default path when axpy_init(NULL) / AXPY_CONFIG is unset. */
    #define AXPY_DEFAULT_CONFIG "config"

    /*
     * Process-lifetime CONFIG root from config.idl / YAML.
     * Strings (prefix) point into the dcerpc mem-tree; free only via axpy_exit()
     * or by replacing with another successful axpy_init().
     * NULL until axpy_init() succeeds.
     */

    struct config_CONFIG *axpy_config;
---

--- at the end of the file, after all the stubs
    /* ------------------------------------------------------------------ */
    /* Config load / free and process lifetime hooks (after stubs)        */
    /* ------------------------------------------------------------------ */
    
    /*
     * Load CONFIG YAML into axpy_config.
     *
     * path may be NULL or empty → use $AXPY_CONFIG if set, else "config".
     * Replaces any previous config (frees the old mem-tree).
     * Returns 0 on success, -1 on error (axpy_config left NULL).
     */
    int
    axpy_init(const char *path)
    {
            struct config_CONFIG *cfg;
            const char *env;
    
            if (path == NULL || path[0] == '\0') {
                    env = getenv("AXPY_CONFIG");
                    if (env != NULL && env[0] != '\0') {
                            path = env;
                    } else {
                            path = AXPY_DEFAULT_CONFIG;
                    }
            }
    
            if (access(path, R_OK) != 0) {
                    fprintf(stderr, "axpy: config %s: %s\n", path, strerror(errno));
                    return -1;
            }
    
            cfg = dcerpc_read_yaml_file(path, config_CONFIG_coder,
                                        sizeof(struct config_CONFIG));
            if (cfg == NULL) {
                    fprintf(stderr, "axpy: failed to decode CONFIG from %s\n",
                            path);
                    return -1;
            }
    
            if (axpy_config != NULL) {
                    dcerpc_free_data(NULL, axpy_config);
                    axpy_config = NULL;
            }
            axpy_config = cfg;
    
            printf("axpy: loaded config from %s (a=%u base=%d prefix=\"%s\")\n",
                   path,
                   axpy_config->a,
                   (int)axpy_config->base,
                   axpy_config->prefix ? axpy_config->prefix : "");
            return 0;
    }
    
    /*
     * Free the CONFIG mem-tree held in axpy_config.
     * Safe to call more than once; leaves axpy_config NULL.
     */
    void
    axpy_exit(void)
    {
            if (axpy_config != NULL) {
                    dcerpc_free_data(NULL, axpy_config);
                    axpy_config = NULL;
            }
    }
    
    /*
     * axpy_init() is serviced's SERVICE_INIT, called with -c's path before it
     * registers; free the config when the process ends (GCC/clang).
     */
    static void __attribute__((destructor))
    axpy_dtor(void)
    {
            axpy_exit();
    }
---

Nice. Now we have code that will read the config into a global variable and free it
on process termination. serviced.c calls axpy_init() at startup (see below), with
the file given by -c, and the service refuses to start without a config rather
than run and fail every call.

    
Now we can implement the actual business logic for the server. We do this by filling in
the stub for the compute function.  We want to to generate and return a string of
the result of the computation.

---
    int
    axpy_compute_stub(struct dcerpc_context *dce,
                      struct dcerpc_pdu *pdu,
                      void *reqv, void *repv)
    {
            struct axpy_compute_req *req = reqv;
            struct axpy_compute_rep *rep = repv;
            const char *prefix;
            char *buf;
            int n;
    
            (void)dce;
    
            if (req == NULL || rep == NULL || pdu == NULL) {
                    return -1;
            }
            memset(rep, 0, sizeof(*rep));
    
            if (axpy_config == NULL) {
                    fprintf(stderr, "axpy: compute: config not loaded\n");
                    return -1;
            }
    
            /* BLAS AXPY: y := a*x + y (uint32 wrap is fine for this example). */
            rep->y = axpy_config->a * req->x + req->y;
            prefix = axpy_config->prefix ? axpy_config->prefix : "";
    
            buf = dcerpc_alloc_data(pdu, 128);
            if (buf == NULL) {
                    return -1;
            }
    
            switch (axpy_config->base) {
            case BASE_HEX:
                    n = snprintf(buf, 128, "%s0x%x", prefix, rep->y);
                    break;
            case BASE_OCT:
                    n = snprintf(buf, 128, "%s0%o", prefix, rep->y);
                    break;
            case BASE_DEC:
            default:
                    n = snprintf(buf, 128, "%s%u", prefix, rep->y);
                    break;
            }
            if (n < 0 || n >= 128) {
                    return -1;
            }
    
            rep->result = buf;
            rep->status = 0; /* WERROR / NERR_Success */
    
            printf("axpy: compute a=%u x=%u y=%u → y=%u \"%s\"\n",
                   axpy_config->a, req->x, req->y, rep->y, rep->result);
            return 0;
    }
---

That's it. Now the server is pretty much finished.
Now we just add the generic service wrapper, serviced.c, and compile it.

serviced.c needs to be compiled with `-DSERVICE=axpy` so it picks up `axpy_server.h`,
registers \pipe\axpy over dcerpcd’s control socket, and serves the pipe itself with
libdcerpc's server runtime: BIND, the NDR flavor the client asks for, and the
calls into `axpy_stubs[]` all happen in the axpy process. dcerpcd only forwards
the pipe's bytes.

A pipe can serve more than one interface. With another IDL, say mul.idl, compiled
the same way, `-DSERVICE=calc -DSERVICE_INTERFACES='X(axpy) X(mul)'` serves both
on \pipe\calc.

It also needs `-DSERVICE_INIT=axpy_init`: that gives the service a `-c config`
argument and calls `axpy_init()` with it before registering. Without -c,
axpy_init() falls back to $AXPY_CONFIG and then to ./config.

Compile and link with both coders and the stubs.

Then just launch it and it should connect to and register with the dcerpcd master
daemon:

    $ ./axpy -c /path/to/config


Building a sync client
======================

The example client is mostly boilerplate but the meat of it is calling into
dcerpc_call() to exchange the request and response structures with the server.

This call is proxied to the server we just built via the dcerpcd service
that both acts as an enpoint mapper but also a service proxy.


axpy-clnt.c
-----------
This example uses the synchronous API for simplicity. For real applications you will probably
use the async API instead.

---
    #include <stdint.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    
    #include "axpy_coder.h"
    
    static int
    usage(void)
    {
            fprintf(stderr,
                    "Usage:\n"
                    "  axpy-clnt <smb2-url> <x> <y>\n\n"
                    "URL format:\n"
                    "  smb://[<domain>;][<username>@]<host>[:<port>]/[?args]\n"
                    "  Query args (optional): sign, seal, sec=ntlmssp|krb5, ...\n\n"
                    "Connects to IPC$/" axpy_PIPE_NAME " and calls compute(x, y).\n"
                    "Prints the response string (prefix + a*x+y in CONFIG base).\n");
            exit(1);
    }
    
    int
    main(int argc, char *argv[])
    {
            struct dcerpc_context *dce = NULL;
            struct axpy_compute_req req;
            struct axpy_compute_rep *rep = NULL;
            uint32_t x, y;
            char *end = NULL;
            int rc = 1;
    
            if (argc != 4 || !strcmp(argv[1], "-h") || !strcmp(argv[1], "--help")) {
                    usage();
            }
    
            x = (uint32_t)strtoul(argv[2], &end, 0);
            if (end == argv[2] || (end && *end != '\0')) {
                    fprintf(stderr, "invalid integer x: %s\n", argv[2]);
                    return 1;
            }
    
            y = (uint32_t)strtoul(argv[3], &end, 0);
            if (end == argv[3] || (end && *end != '\0')) {
                    fprintf(stderr, "invalid integer y: %s\n", argv[3]);
                    return 1;
            }
    
            dce = dcerpc_create_context_smb(argv[1]);
            if (dce == NULL) {
                    fprintf(stderr, "Failed to create dce context for %s\n",
                            argv[1]);
                    return 1;
            }
    
            if (dcerpc_connect_context(dce, axpy_PIPE_NAME, &axpy_interface) != 0) {
                    fprintf(stderr, "Failed to connect %s: %s\n",
                            axpy_PIPE_NAME, dcerpc_get_error(dce));
                    goto out;
            }
    
            memset(&req, 0, sizeof(req));
            req.x = x;
            req.y = y;
    
            rep = dcerpc_call(dce, AXPY_COMPUTE,
                              axpy_compute_req_coder, &req,
                              axpy_compute_rep_coder,
                              sizeof(struct axpy_compute_rep));
            if (rep == NULL) {
                    fprintf(stderr, "compute failed: %s\n", dcerpc_get_error(dce));
                    goto out;
            }
            if (rep->status != 0) {
                    fprintf(stderr, "compute status=0x%x result=%s\n",
                            rep->status,
                            rep->result ? rep->result : "(null)");
                    goto out;
            }
    
            printf("%s\n", rep->result ? rep->result : "");
            rc = 0;
    
    out:
            if (rep) {
                    dcerpc_free_data(dce, rep);
            }
            dcerpc_destroy_context(dce);
            return rc;
    }
---

Compile and link with the axpy coders.

Then test and run it:

---
    $ ./axpy-clnt smb://127.0.0.1/?sec=ntlmssp 8 10
    The result is: 26
----


Building an async client
========================

In the previous example we built a simple client using the sync API.
More complex applications might want an event driven design where you use
the async API and plug it into your existing event-loop.

This gives you full control of how the smb2 context is set up as well as
non-blocking behavior that will integrate nicely with the rest of your application.

---
   #include <errno.h>
   #include <poll.h>
   #include <stdint.h>
   #include <stdio.h>
   #include <stdlib.h>
   #include <string.h>
   
   #include "smb2.h"
   #include "libsmb2.h"
   #include "libsmb2-raw.h"
   
   #include "axpy_coder.h"
   
   static volatile int is_finished;
   static int exit_status = 1;
   
   struct clnt_state {
           struct smb2_context *smb2;
           struct smb2_url *url;
           struct dcerpc_context *dce;
           struct axpy_compute_req req;
   };
   
   static int
   usage(void)
   {
           fprintf(stderr,
                   "Usage:\n"
                   "  axpy-clnt-async <smb2-url> <x> <y>\n\n"
                   "URL format:\n"
                   "  smb://[<domain>;][<username>@]<host>[:<port>]/[?args]\n"
                   "  Query args (optional): sign, seal, sec=ntlmssp|krb5, ...\n\n"
                   "Async client: owns the smb2 context, connects IPC$ with\n"
                   "smb2_connect_share_async, then open/bind + compute via\n"
                   "dcerpc_*_async. Prints the response string.\n");
           exit(1);
   }
   
   static void
   finish(struct clnt_state *st, int status)
   {
           exit_status = status;
           is_finished = 1;
           (void)st;
   }
   
   static void
   call_cb(struct dcerpc_context *dce, int status,
           void *command_data, void *cb_data)
   {
           struct clnt_state *st = cb_data;
           struct axpy_compute_rep *rep = command_data;
   
           if (status != (int)SMB2_STATUS_SUCCESS) {
                   fprintf(stderr, "compute failed (%s) %s\n",
                           strerror(-status), dcerpc_get_error(dce));
                   if (rep) {
                           dcerpc_free_data(dce, rep);
                   }
                   finish(st, 1);
                   return;
           }
   
           if (rep == NULL) {
                   fprintf(stderr, "compute: empty response\n");
                   finish(st, 1);
                   return;
           }
   
           if (rep->status != 0) {
                   fprintf(stderr, "compute status=0x%x result=%s\n",
                           rep->status,
                           rep->result ? rep->result : "(null)");
                   dcerpc_free_data(dce, rep);
                   finish(st, 1);
                   return;
           }
   
           printf("%s\n", rep->result ? rep->result : "");
           dcerpc_free_data(dce, rep);
           finish(st, 0);
   }
   
   static void
   bind_cb(struct dcerpc_context *dce, int status,
           void *command_data, void *cb_data)
   {
           struct clnt_state *st = cb_data;
   
           (void)command_data;
   
           if (status != (int)SMB2_STATUS_SUCCESS) {
                   fprintf(stderr, "Failed to bind %s: %s\n",
                           axpy_PIPE_NAME, dcerpc_get_error(dce));
                   finish(st, 1);
                   return;
           }
   
           if (dcerpc_call_async(dce, AXPY_COMPUTE,
                                 axpy_compute_req_coder, &st->req,
                                 axpy_compute_rep_coder,
                                 sizeof(struct axpy_compute_rep),
                                 call_cb, st) != 0) {
                   fprintf(stderr, "dcerpc_call_async failed: %s\n",
                           dcerpc_get_error(dce));
                   finish(st, 1);
           }
   }
   
   /*
    * IPC$ tree connect finished. Create a dcerpc context on the caller's
    * smb2 (caller retains ownership) and open/bind the named pipe async.
    */
   static void
   connect_cb(struct smb2_context *smb2, int status,
              void *command_data, void *cb_data)
   {
           struct clnt_state *st = cb_data;
   
           (void)command_data;
   
           if (status != 0) {
                   fprintf(stderr, "Failed to connect IPC$: (%s) %s\n",
                           strerror(-status), smb2_get_error(smb2));
                   finish(st, 1);
                   return;
           }
   
           st->dce = dcerpc_create_context(st->smb2);
           if (st->dce == NULL) {
                   fprintf(stderr, "Failed to create dce context: %s\n",
                           smb2_get_error(st->smb2));
                   finish(st, 1);
                   return;
           }
   
           if (dcerpc_connect_context_async(st->dce, axpy_PIPE_NAME,
                                            &axpy_interface,
                                            bind_cb, st) != 0) {
                   fprintf(stderr, "Failed to open %s: %s\n",
                           axpy_PIPE_NAME, dcerpc_get_error(st->dce));
                   dcerpc_destroy_context(st->dce);
                   st->dce = NULL;
                   finish(st, 1);
           }
   }
   
   int
   main(int argc, char *argv[])
   {
           struct clnt_state st;
           struct pollfd pfd;
           char *end = NULL;
           uint32_t x, y;
   
           if (argc != 4 || !strcmp(argv[1], "-h") || !strcmp(argv[1], "--help")) {
                   usage();
           }
   
           x = (uint32_t)strtoul(argv[2], &end, 0);
           if (end == argv[2] || (end && *end != '\0')) {
                   fprintf(stderr, "invalid integer x: %s\n", argv[2]);
                   return 1;
           }
   
           y = (uint32_t)strtoul(argv[3], &end, 0);
           if (end == argv[3] || (end && *end != '\0')) {
                   fprintf(stderr, "invalid integer y: %s\n", argv[3]);
                   return 1;
           }
   
           memset(&st, 0, sizeof(st));
           st.req.x = x;
           st.req.y = y;
   
           st.smb2 = smb2_init_context();
           if (st.smb2 == NULL) {
                   fprintf(stderr, "Failed to init smb2 context\n");
                   return 1;
           }
   
           st.url = smb2_parse_url(st.smb2, argv[1]);
           if (st.url == NULL) {
                   fprintf(stderr, "Failed to parse url: %s\n",
                           smb2_get_error(st.smb2));
                   smb2_destroy_context(st.smb2);
                   return 1;
           }
   
           if (st.url->user) {
                   smb2_set_user(st.smb2, st.url->user);
           }
           if (st.url->domain) {
                   smb2_set_domain(st.smb2, st.url->domain);
           }
   
           /*
            * DCE/RPC named pipes always use IPC$. Query args from the URL
            * (?sign, ?seal, ?sec=…) were applied by smb2_parse_url.
            */
           if (smb2_connect_share_async(st.smb2, st.url->server, "IPC$",
                                        st.url->user, connect_cb, &st) != 0) {
                   fprintf(stderr, "smb2_connect_share_async failed: %s\n",
                           smb2_get_error(st.smb2));
                   smb2_destroy_url(st.url);
                   smb2_destroy_context(st.smb2);
                   return 1;
           }

           while (!is_finished) {
                   pfd.fd = smb2_get_fd(st.smb2);
                   pfd.events = smb2_which_events(st.smb2);
   
                   if (poll(&pfd, 1, 1000) < 0) {
                           fprintf(stderr, "poll failed: %s\n", strerror(errno));
                           break;
                   }
                   if (pfd.revents == 0) {
                           continue;
                   }
                   if (smb2_service(st.smb2, pfd.revents) < 0) {
                           fprintf(stderr, "smb2_service failed: %s\n",
                                   smb2_get_error(st.smb2));
                           break;
                   }
           }
   
           if (st.dce) {
                   dcerpc_destroy_context(st.dce);
           }
           smb2_disconnect_share(st.smb2);
           smb2_destroy_url(st.url);
           smb2_destroy_context(st.smb2);
   
           return exit_status;
   }
---
