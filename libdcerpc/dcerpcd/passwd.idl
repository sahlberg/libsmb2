/* SPDX-License-Identifier: BSD-2-Clause */
/*
 * dcerpcd NTLM password database (data-only IDL → YAML via dcerpc_read_yaml_file).
 *
 * File format (list wrapped in a struct so size_is can size the array):
 *   PASSWD:
 *     count: 2
 *     entry:
 *       - user: alice
 *         password: secret
 *       - user: bob
 *         password: none
 *
 * The size_is array field is named "entry" to match the element type name
 * (idlcomp YAML ptr/carray keys must agree).
 *
 * The file must be a regular file owned by the process euid with mode 0600.
 * Full-line and trailing # comments are allowed (see yaml_next_kv).
 */

typedef struct {
	[string,charset(UTF16)] uint16_t *user;
	[string,charset(UTF16)] uint16_t *password;
} entry;

typedef struct {
	uint32_t count;
	[size_is(count)] entry *entry;
} PASSWD;
