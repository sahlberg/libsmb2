} SERVER_INFO_502, *LPSERVER_INFO_502;

typedef struct {
	uint32_t SessOpens;
	uint32_t SessVcs;
	uint32_t OpenSearch;
	uint32_t SizReqBuf;
	uint32_t InitWorkItems;
	uint32_t MaxWorkItems;
