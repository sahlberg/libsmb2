} SERVER_INFO_503, *LPSERVER_INFO_503;

typedef [switch_type(SERVER_INFO_LEVEL)] union {
	[case(SERVER_INFO_100)] LPSERVER_INFO_100 ServerInfo100;
	[case(SERVER_INFO_101)] LPSERVER_INFO_101 ServerInfo101;
	[case(SERVER_INFO_102)] LPSERVER_INFO_102 ServerInfo102;
	[case(SERVER_INFO_103)] LPSERVER_INFO_103 ServerInfo103;
	[case(SERVER_INFO_502)] LPSERVER_INFO_502 ServerInfo502;
	[case(SERVER_INFO_503)] LPSERVER_INFO_503 ServerInfo503;
} SERVER_INFO, *LPSERVER_INFO;

/*
 * Server statistics (NetrServerStatisticsGet)
 */
typedef struct {
	uint32_t Start;
	uint32_t FOpens;
	uint32_t DevOpens;
	uint32_t JobsQueued;
	uint32_t SOpens;
	uint32_t STimedOut;
	uint32_t SErrorOut;
	uint32_t PwErrors;
	uint32_t PermErrors;
	uint32_t SysErrors;
	uint32_t BytesSentLow;
	uint32_t BytesSentHigh;
	uint32_t BytesRcvdLow;
	uint32_t BytesRcvdHigh;
	uint32_t AvResponse;
	uint32_t ReqBufNeed;
	uint32_t BigBufNeed;
} STAT_SERVER_0, *LPSTAT_SERVER_0;

/*
 * Time of day (NetrRemoteTOD)
 */
typedef struct {
	uint32_t ElapsedT;
	uint32_t Msecs;
	uint32_t Hours;
	uint32_t Mins;
	uint32_t Secs;
	uint32_t Hunds;
	long TimeZone;
	uint32_t TInterval;
	uint32_t Day;
	uint32_t Month;
	uint32_t Year;
	uint32_t WeekDay;
} TIME_OF_DAY_INFO, *LPTIME_OF_DAY_INFO;

